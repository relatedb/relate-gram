// People and the relationships between them.
/** A documentation comment is ignored like any other comment. */
(ada:Person {name: "Ada", born: 1815})
(grace:Person {name: "Grace", born: 1906})
(alan:Person:Mathematician {name: "Alan"})
(ada)-[:KNOWS {since: 1840}]->(grace)
(alan)-[:KNOWS]->(ada)<-[:MENTORS]-(grace) // a path with a right and a left arrow
